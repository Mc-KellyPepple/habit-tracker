# Copy to .env for local dev (`npm run dev`). On Render, set these under
# your service's Environment tab instead — never commit a real .env.

# Supabase project settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The SERVICE ROLE key (not anon) — bypasses RLS so this server can see
# every user's habits/tokens. Keep this out of the mobile app entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. The external scheduler must send this exact
# value in an `x-cron-secret` header for /trigger-reminders to run.
CRON_SECRET=change-me-to-something-long-and-random

PORT=3000
